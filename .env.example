# Configurações do Ambiente e Parâmetros de Execução
# Copie este arquivo para .env para customizar localmente se desejado

# Servidor da API FastAPI (Opcional - Componente extra)
API_HOST=127.0.0.1
API_PORT=8000

# Dispositivo de processamento (deixe vazio para auto-detecção CUDA/CPU)
FORCE_DEVICE=
